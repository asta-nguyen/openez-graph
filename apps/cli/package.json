{
  "name": "@openez-graph/cli",
  "version": "0.9.2",
  "description": "Local-first code intelligence engine — index, query, and graph your codebase with zero config. SQLite-only, MCP-first.",
  "license": "MIT",
  "author": "Asta Nguyen",
  "homepage": "https://github.com/asta-nguyen/openez-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asta-nguyen/openez-graph.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/asta-nguyen/openez-graph/issues"
  },
  "keywords": [
    "code-intelligence",
    "code-graph",
    "mcp",
    "model-context-protocol",
    "code-indexing",
    "codebase",
    "retrieval",
    "sqlite",
    "local-first",
    "developer-tools",
    "ai-coding",
    "claude-code",
    "codex"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/cli.cjs",
  "bin": {
    "openez": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "openez": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openez-graph/config": "workspace:*",
    "@openez-graph/core": "workspace:*",
    "@openez-graph/db": "workspace:*",
    "@openez-graph/indexer": "workspace:*",
    "@openez-graph/mcp": "workspace:*",
    "@openez-graph/web": "workspace:*",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "hono": "^4.12.33",
    "smol-toml": "^1.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2"
  }
}

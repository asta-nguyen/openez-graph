{
  "name": "openez-graph",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "start": "concurrently --names web,mcp --prefix-colors cyan,green --kill-others \"pnpm dev:web\" \"pnpm mcp\"",
    "dev:web": "pnpm --filter @openez-graph/web dev:all",
    "build:web": "pnpm --filter @openez-graph/web build",
    "build:cli": "pnpm --filter @openez-graph/cli build",
    "openez": "pnpm --filter @openez-graph/cli openez",
    "init": "pnpm --filter @openez-graph/cli openez init",
    "index": "pnpm --filter @openez-graph/cli openez index",
    "reindex": "pnpm --filter @openez-graph/cli openez reindex",
    "watch": "pnpm --filter @openez-graph/cli openez watch",
    "serve": "pnpm --filter @openez-graph/cli openez serve",
    "status": "pnpm --filter @openez-graph/cli openez status",
    "list": "pnpm --filter @openez-graph/cli openez list",
    "mcp": "pnpm --filter @openez-graph/cli openez serve --mcp",
    "worker": "pnpm --filter @openez-graph/worker worker",
    "benchmark:query": "pnpm --filter @openez-graph/worker benchmark:query",
    "benchmark:retrieval": "pnpm --filter @openez-graph/worker benchmark:retrieval",
    "typecheck": "turbo run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "server-only": "^0.0.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "qs": "6.15.2",
      "sharp": "0.35.3"
    }
  }
}

{
  "name": "openez-graph",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "start": "concurrently --names web,mcp --prefix-colors cyan,green --kill-others \"pnpm dev:web\" \"pnpm mcp\"",
    "dev:web": "pnpm --filter @openez-graph/web dev:all",
    "build:web": "pnpm --filter @openez-graph/web build",
    "build:cli": "pnpm --filter @openez-graph/cli build",
    "openez": "pnpm --filter @openez-graph/cli openez",
    "init": "pnpm --filter @openez-graph/cli openez init",
    "index": "pnpm --filter @openez-graph/cli openez index",
    "reindex": "pnpm --filter @openez-graph/cli openez reindex",
    "watch": "pnpm --filter @openez-graph/cli openez watch",
    "serve": "pnpm --filter @openez-graph/cli openez serve",
    "status": "pnpm --filter @openez-graph/cli openez status",
    "list": "pnpm --filter @openez-graph/cli openez list",
    "mcp": "pnpm --filter @openez-graph/cli openez serve --mcp",
    "benchmark:retrieval": "OPENEZ_RUN_BENCHMARK=1 bun test tests/embed-benchmark.test.ts",
    "benchmark:retrieval:embeddings": "OPENEZ_RUN_BENCHMARK=1 OPENEZ_BENCHMARK_EMBEDDINGS=1 bun test tests/embed-benchmark.test.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oxlint/plugins": "^1.78.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.8.0",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "qs": "6.15.2",
      "sharp": "0.35.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
